{
  "name": "mira-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run --exclude tests/database.integration.test.ts --exclude tests/live.integration.test.ts",
    "test:database": "vitest run tests/database.integration.test.ts",
    "test:live": "vitest run tests/live.integration.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "google:authorize": "tsx scripts/google-authorize.ts",
    "bookings:reconcile": "tsx scripts/reconcile.ts",
    "retell:schemas": "tsx scripts/retell-schemas.ts",
    "providers:check": "tsx scripts/provider-check.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cors": "2.8.6",
    "dotenv": "18.0.7",
    "express": "5.3.0",
    "google-auth-library": "10.5.0",
    "googleapis": "178.0.0",
    "helmet": "8.3.0",
    "libphonenumber-js": "1.13.15",
    "luxon": "3.7.2",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "retell-sdk": "6.2.5",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/luxon": "3.7.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "embedded-postgres": "18.4.0-beta.17",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
