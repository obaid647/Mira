{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "const": "demo-business"
    },
    "service_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "The verified service id collected during the conversation."
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "The verified date collected during the conversation."
    },
    "period": {
      "default": "any",
      "type": "string",
      "enum": [
        "morning",
        "afternoon",
        "evening",
        "any"
      ],
      "description": "The verified period collected during the conversation."
    }
  },
  "required": [
    "business_id",
    "service_id",
    "date"
  ],
  "additionalProperties": false
}
